# 서버 전용 (NEXT_PUBLIC_ 접두사 금지 — 클라이언트에 노출됨)
GEMINI_API_KEY=
# 선택: 기본값 gemini-flash-latest
GEMINI_MODEL=
# 선택: 기본 모델이 과부하일 때 순서대로 시도할 대체 모델 (쉼표 구분)
# 기본값 gemini-2.5-flash,gemini-flash-lite-latest
GEMINI_FALLBACK_MODELS=
# 선택: 기본값 0.6
GEMINI_TEMPERATURE=
# 선택: IP당 분당 LLM 호출 수, 기본값 10
LLM_RATE_LIMIT_PER_MINUTE=

# 공개 가능 값: 공유 카드에 표시할 서비스 주소
NEXT_PUBLIC_SITE_URL=
